# ---------------------------------------------------------------------------
# FoodieBook by Marshru — environment template
# Copy to backend/.env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL (SQLAlchemy + psycopg v3)
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/foodiebook

# Comma-separated allowed frontend origins
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Session cookies
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_DAYS=7

# CSRF (keep enabled)
CSRF_ENABLED=true

# Uploads (relative to backend/)
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=6

# Seeded administrator
ADMIN_EMAIL=admin@foodiebook.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Marshru

# Password reset
PASSWORD_RESET_TOKEN_MINUTES=30

# Optional SMTP for reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@foodiebook.app
