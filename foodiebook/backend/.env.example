SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://postgres@localhost:5434/foodiebook
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5399
UPLOAD_FOLDER=
MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:5189,http://127.0.0.1:5189
FRONTEND_URL=http://127.0.0.1:5189
# Development convenience: returns the reset token in the API response when no
# email provider is configured. Set to false in production and send email instead.
SHOW_RESET_TOKEN=true
RESET_TOKEN_TTL_MINUTES=30
CSRF_ENABLED=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
