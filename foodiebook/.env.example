# ---- Backend ----
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://postgres@localhost:5434/foodiebook
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5399
UPLOAD_FOLDER=
MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:5189,http://127.0.0.1:5189
FRONTEND_URL=http://127.0.0.1:5189
SHOW_RESET_TOKEN=true
RESET_TOKEN_TTL_MINUTES=30
CSRF_ENABLED=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# ---- Frontend (also copy into frontend/.env for Vite) ----
VITE_API_URL=http://127.0.0.1:5399/api
VITE_API_ORIGIN=http://127.0.0.1:5399
